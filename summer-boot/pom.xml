<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.jiebaba.summer</groupId>
        <artifactId>summer-parent</artifactId>
        <version>4.0</version>
    </parent>
    <artifactId>summer-boot</artifactId>
    <name>summer-boot</name>
    <description>summer application bootstrap and auto-configuration: SummerApplication.run(), auto-configuration, 嵌入式 HTTP/web（原 summer-web）、ORM/事务/多数据源（原 summer-data）、JWT 安全（原 summer-security）、文档读写（原 summer-office，OCR 移至 summer-support）。核心运行时（IoC/AOP/日志/扫描/定时/env/json/util/onnx/test，包名 cn.jiebaba.summer.core 不变）已拆至 summer-core 模块，本模块经 Maven 依赖传递获得。</description>
    <dependencies>
        <!-- 核心运行时：IoC/AOP/日志/扫描/定时/env/json/util/onnx/test 均在 summer-core；
             SLF4J API 与 JUnit API 的 optional 依赖已随对应类（logging.slf4j/test 包）迁至 summer-core -->
        <dependency>
            <groupId>cn.jiebaba.summer</groupId>
            <artifactId>summer-core</artifactId>
            <version>${summer.version}</version>
        </dependency>
    </dependencies>
</project>
